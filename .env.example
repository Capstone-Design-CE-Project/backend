# ── DB (PostgreSQL) ───────────────────────────────────────────
# 아래 5개를 비워두면 로컬 SQLite(./capstone.db)로 자동 폴백된다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=capstone
DB_USER=postgres
DB_PASSWORD=
# 직접 지정하고 싶으면 (최우선 적용)
# DATABASE_URL=postgresql+psycopg2://user:pw@host:5432/dbname

# ── 인증 ──────────────────────────────────────────────────────
# 운영 배포 전 반드시 교체할 것: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
CLIENT_TOKEN_EXPIRE_MINUTES=20160

# ── CLOVA Speech (STT) ────────────────────────────────────────
# 비워두면 목(mock) 녹취록으로 동작한다.
CLOVA_SPEECH_SECRET=
CLOVA_SPEECH_INVOKE_URL=

# ── OpenAI (요약 + DALL-E) ────────────────────────────────────
# 비워두면 규칙 기반 요약 + 플레이스홀더 이미지로 동작한다.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

# ── 시간대 ────────────────────────────────────────────────────
# DB에 저장하는 모든 시각의 기준. 서버 OS/DB 시간대와 무관하게 적용된다.
APP_TIMEZONE=Asia/Seoul

# ── 기타 ──────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
CORS_ORIGINS=*
DEBUG=False
# konlpy(JVM) 미설치 환경에서는 False로 두면 형태소 분석을 건너뛴다.
ENABLE_MORPH_ANALYSIS=True
# 인증 없는 구버전 /pipeline 라우터 노출 여부 (운영에서는 False 권장)
LEGACY_PIPELINE_ENABLED=True
OPEN_COUNSELOR_SIGNUP=True
