[
  {
    "text": "Q:지금 어떤 풍경이 떠오르나요?"
  },
  {
    "text": "A:바닷가가 보여요"
  },
  {
    "text": "Q:바닷가에는 뭐가 있나요?"
  },
  {
    "text": "A:등대와 배가 보입니다."
  },
  {
    "text": "Q:등대는 어떤 색깔인가요?"
  },
  {
    "text": "A:남색입니다."
  },
  {
    "text": "Q:배는 어떤색인가요?"
  },
  {
    "text": "A:흰색입니다."
  },
  {
    "text": "Q:배는 어디에 있나요?"
  },
  {
    "text": "A:등대 옆에 묶여있습니다."
  }
]
